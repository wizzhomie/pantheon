+def _color_from_env() -> bool | None:
+    """Read the ``NO_COLOR`` and ``FORCE_COLOR`` environment variables.
+
+    Returns ``True`` if color was explicitly forced, ``False`` if it was
+    explicitly disabled, and ``None`` if the environment says nothing about
+    color.  ``NO_COLOR`` wins when both are set, since its whole purpose is
+    to opt out of color output.
+
+    ``NO_COLOR`` follows https://no-color.org: any non-empty value disables
+    color.  ``FORCE_COLOR`` treats ``0``, ``false``, ``no``, ``off`` and the
+    empty string as disabling, and any other value as forcing color on.
+    """
+    no_color = os.environ.get("NO_COLOR")
+
+    if no_color:
+        return False
+
+    force_color = os.environ.get("FORCE_COLOR")
+
+    if force_color is not None:
+        return force_color.strip().lower() not in ("", "0", "false", "no", "off")
+
+    return None
+
+
 def should_strip_ansi(
     stream: t.IO[t.Any] | None = None, color: bool | None = None
 ) -> bool:
     if color is None:
+        # An explicit color choice is handled below; otherwise honor the
+        # environment before falling back to tty detection, so a pipe or CI
+        # log can still be colored (or suppressed) on request.
+        env_color = _color_from_env()
+
+        if env_color is not None:
+            return not env_color
+
         if stream is None:
             stream = sys.stdin
         elif hasattr(stream, "color"):
