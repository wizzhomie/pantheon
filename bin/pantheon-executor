#!/usr/bin/env python3
"""Run the reference executor from the checkout: the same shim as ``bin/pantheon``.

The box's ``profile/executor.toml`` names this file as its command, so the adapter imports
``harness`` without an install and without depending on the caller's working directory.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from harness.executors.deepseek import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
